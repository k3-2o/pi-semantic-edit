{
  "name": "pi-semantic-edit",
  "version": "0.2.1",
  "description": "Aider-format SEARCH/REPLACE edit tool for Pi \u2014 OpenDev 9-pass fuzzy matcher chain, uniqueness guard, stale-read detection, zero runtime deps. Replaces the built-in edit.",
