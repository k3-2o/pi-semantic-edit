  "author": "K2",
  "homepage": "https://github.com/k3-2o/pi-semantic-edit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k3-2o/pi-semantic-edit.git"
  },
  "bugs": {
    "url": "https://github.com/k3-2o/pi-semantic-edit/issues"
  },
  "keywords": [
